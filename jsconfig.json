{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": "./",
    "paths": {
      "#/*": ["src/*"],
      "#app/*": ["src/app/*"],
      "#domain/*": ["src/domain/*"],
      "#infrastructure/*": ["src/infrastructure/*"],
      "#shared/*": ["src/shared/*"],
    }
  },
  "include": ["src/**/*.mjs", "index.js", "src/**/*.js"],
  "exclude": ["node_modules"]
}